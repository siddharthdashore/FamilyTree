# ==============================================================================
# VanshaSetu Middleware Configuration & Cryptographic Secrets
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=3000

# Database Configuration (BigRock Localhost / Internal Socket)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vanshasetu_user
DB_PASSWORD=ChangeThisToStrongPassword123!
DB_NAME=vanshasetu_db
DB_CONNECTION_LIMIT=15

# Zero-Knowledge Salt for Document Deduplication (SHA-256)
HASH_SALT=VANSHA_SETU_SECURE_SALT_9841_PROD_SECRET

# Master Key for Field-Level AES-256-GCM Encryption (32-byte hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FLE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC API Request Signing Secret (shared with verified mobile clients)
API_HMAC_SECRET=VANSHA_HMAC_SHARED_SECRET_KEY_PROD_8492

# E2EE Payload Encryption Toggle ('true' for enforced JWE payload encryption, 'optional' for mixed mode)
E2EE_MODE=optional
